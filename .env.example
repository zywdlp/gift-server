# 运行环境：dev（开发）、test（测试）或 prod（生产）
NODE_ENV=dev
# 后端 HTTP 服务端口
APP_PORT=8000

# MySQL 连接地址
MYSQL_HOST=127.0.0.1
# MySQL 服务端口
MYSQL_PORT=3306
# MySQL 登录账号
MYSQL_USER=app_user
# MySQL 登录密码；请替换为实际强密码
MYSQL_PASSWORD=replace-with-a-strong-password
# 使用的数据库名称
MYSQL_DB=gift_admin
# 是否输出 TypeORM 执行的 SQL；生产环境建议设为 false
TYPEORM_LOGGING=true

# JWT 签名密钥，至少 32 位随机字符串；生产环境必须替换
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# 管理后台 JWT 有效期，单位：秒
JWT_EXPIRES_IN=7200
# JWT 签发者标识
JWT_ISSUER=gift-server

# 阿里云号码认证服务 → 短信认证。
# 个人和企业账号使用同一套接口；正式部署请改用 RAM 子账号 AccessKey。
# 阿里云 AccessKey ID
ALIYUN_ACCESS_KEY_ID=
# 阿里云 AccessKey Secret
ALIYUN_ACCESS_KEY_SECRET=
# 短信认证服务中配置的签名名称
ALIYUN_SMS_AUTH_SIGN_NAME=
# 短信认证服务中配置的模板编码；100001 为个人开发测试模板
ALIYUN_SMS_AUTH_TEMPLATE_CODE=100001
