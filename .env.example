# 礼品兑换卡系统后端环境配置
# 开发环境使用 .env.dev；生产环境使用 .env.prod。仅修改各配置项的值，不要改变键名。

# 运行环境与 HTTP 服务
NODE_ENV=dev
APP_PORT=8000

# 跨域与接口文档。CORS_ORIGINS 多个地址用英文逗号分隔；生产环境必须填写。
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true

# MySQL 连接。应用账号只应拥有 gift_platform 的增删改查权限。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=gift_user_dev
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DB=gift_platform
TYPEORM_LOGGING=true
# 始终保持 false，表结构仅通过 init_gift.sql 初始化。
TYPEORM_SYNCHRONIZE=false

# 商品图片目录。生产环境必须填写服务器持久化绝对路径。
UPLOAD_DIR=uploads

# 管理后台 JWT。生产环境必须使用独立随机密钥。
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7200
JWT_ISSUER=gift-server

# PIN、二维码令牌、手机号密文的固定密钥。上线后不得随意更换。
CARD_SECRET_KEY=REPLACE_WITH_A_STABLE_32_PLUS_CHARACTER_SECRET

# 阿里云短信认证服务。生产环境请使用 RAM 子账号、正式签名和正式模板。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_AUTH_SIGN_NAME=
ALIYUN_SMS_AUTH_TEMPLATE_CODE=100001
