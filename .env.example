NODE_ENV=dev
APP_PORT=8000




MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=app_user
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DB=gift_admin
TYPEORM_LOGGING=true

JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7200
JWT_ISSUER=gift-server

# 仅限本地联调：验证码会直接返回给 H5。接入真实短信服务后必须删除或设为 false。
H5_SMS_DEBUG=true
