{
  "name": "gift-server",
  "version": "2.1.0",
  "description": "礼品管理后台基础服务，基于 NestJS、TypeORM 与 RBAC 权限模型。",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.17.0",
    "pnpm": ">=8.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start:dev": "cross-env NODE_ENV=dev nest start",
    "start:prod": "cross-env NODE_ENV=prod node dist/main",
    "start:debug": "nest start --debug",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=true eslint \"{src,apps,libs}/**/*.ts\"",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=true eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "lint:config": "cross-env ESLINT_USE_FLAT_CONFIG=true eslint --print-config src/main.ts"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@nestjs/common": "^11.1.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.23",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/typeorm": "^11.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "mysql2": "^3.22.3",
    "nest-winston": "^1.10.2",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "svg-captcha": "^1.4.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.30",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "xmcommon": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.41",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
